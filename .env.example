PROJECT_NAME="Privacy-Preserving Federated Learning Backend"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dropout_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dropout_db

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Security
SECRET_KEY="secret-key-change-in-production-for-jwt-signing-security"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=115200

# Storage
STORAGE_DIR="./storage_data"
